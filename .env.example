# ============================================================
# sistema-contable — variables de entorno de la INFRAESTRUCTURA LOCAL
#
# Se copia a `.env` en la raíz. Lo leen tres cosas, y ninguna de ellas atiende usuarios:
#   - `docker compose`, para armar el entorno de cada contenedor (a cada uno le pasa solo lo suyo);
#   - los scripts de base (`db:setup`, `db:migrate`), que corren como DUEÑO DEL ESQUEMA;
#   - los tests contra Postgres real.
#
# NINGÚN proceso que atienda pedidos lee este archivo. Cuando exista `apps/web`, sus variables van en
# `apps/web/.env.local`. La separación no es orden: es el cerrojo. Copiar este archivo tal cual a la
# app le entrega la conexión del dueño del esquema Y la del rol que saltea la RLS — y con eso el
# aislamiento entre clientes deja de existir (ADR-0002).
#
# NUNCA se commitea `.env` ni `.env.local`. Los valores de acá son de DESARROLLO y no valen en ningún
# otro lado: cada entorno genera los suyos.
# ============================================================

# --- Qué entorno es este --------------------------------------------------
# local | staging | produccion.
# OBLIGATORIA Y SIN DEFAULT EN EL CÓDIGO: lo que no está declarado explícitamente como desarrollo se
# trata como producción. Es lista de permitidos, no de prohibidos. Un default acá es exactamente el
# modo de falla que esta variable existe para eliminar.
# No se usa NODE_ENV para esto: NODE_ENV dice cómo se compila, no en qué entorno se corre.
APP_ENTORNO=local
APP_TIMEZONE=America/Argentina/Cordoba

# --- Postgres (ADR-0000 §3.1) ---------------------------------------------
# Credenciales del contenedor local. El puerto se publica solo en 127.0.0.1.
POSTGRES_DB=sistema_contable
POSTGRES_USER=sistema_contable
POSTGRES_PASSWORD=sistema_contable_dev
# OJO: si ya tenés otro proyecto con Postgres/MinIO en esta máquina, estos puertos van a estar
# ocupados y `docker compose up` falla con "port is already allocated". Pasó al probarlo acá (el 9001
# estaba tomado). Cambiá los puertos en TU `.env` — no hace falta tocar el compose ni el código.
#
# ⚠️ SI CAMBIÁS ESTE PUERTO, CAMBIÁ TAMBIÉN LOS TRES DSN DE ABAJO. No se interpolan solos.
# Pasó de verdad al probarlo: quedaron apuntando al 5432, que en esta máquina lo tiene OTRO proyecto,
# y el intento de conexión fue contra la base equivocada (falló por contraseña, pero podría haber
# entrado). Un DSN que apunta a la base de otro producto es peor que un DSN que no funciona.
POSTGRES_PORT=5432

# (1) DUEÑO DEL ESQUEMA — migraciones y scripts locales, nada más. Puede hacer DDL y escribir
#     cualquier tabla, e IGNORA las políticas si no fuera por `force row level security`.
#     Ningún proceso que atienda pedidos la recibe.
DATABASE_URL=postgres://sistema_contable:sistema_contable_dev@localhost:5432/sistema_contable

# (2) ROL DE REQUEST (`app_request`) — SUJETO A RLS. Es la única conexión que puede atender a una
#     persona, y solo a través de `conUsuario()` (ADR-0001 §6). El rol lo crea la migración
#     0001_tenancy.sql sin contraseña; el usuario de login local lo crea `db:setup`
#     (ver packages/data/sql/db-setup.sql) — un secreto nunca va al repo.
APP_DB_USER=app_request_dev
APP_DB_PASSWORD=app_request_dev
DATABASE_URL_APP=postgres://app_request_dev:app_request_dev@localhost:5432/sistema_contable

# (3) ROL DE JOBS (`app_job`) — BYPASSRLS: las políticas NO se evalúan.
#     Lo recibe SOLO un proceso de servidor, y SOLO para tomar trabajo de la cola. El trabajo real
#     corre con `conUsuario()` bajo la identidad de quien lo pidió. Un job que hace todo con
#     BYPASSRLS es un sistema sin aislamiento con pasos extra.
JOB_DB_PASSWORD=app_job_dev
DATABASE_URL_JOB=postgres://app_job:app_job_dev@localhost:5432/sistema_contable

# --- MinIO / S3-compatible (ADR-0000 §3.3) --------------------------------
# En AWS: S3 con dos políticas de IAM. En GCP: Cloud Storage por su API XML + claves HMAC
# ([verificar] URL firmadas). En Supabase: su endpoint S3-compatible. El cliente es el mismo.

# Cuenta de ADMINISTRACIÓN del storage: la usa el contenedor de MinIO y la consola web. Ninguna
# aplicación la recibe (puede borrar buckets enteros).
MINIO_ROOT_USER=sistema_contable
MINIO_ROOT_PASSWORD=sistema_contable_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_BUCKET=sistema-contable
# MinIO ignora la región, pero el cliente de S3 LANZA si no la recibe — y en S3 real o en el endpoint
# compatible de otro proveedor es un valor real. Se declara siempre.
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Cuentas de servicio que crea `minio-init`. Cada proceso recibe UNA sola.
S3_LECTURA_ACCESS_KEY_ID=app_lectura_dev
S3_LECTURA_SECRET_ACCESS_KEY=app_lectura_dev_secret
S3_ESCRITURA_ACCESS_KEY_ID=app_escritura_dev
S3_ESCRITURA_SECRET_ACCESS_KEY=app_escritura_dev_secret

# --- Auth (ADR-0000 §3.2) -------------------------------------------------
# Todavía NO hay adapter real: depende del proveedor de despliegue, que no está decidido.
# `dev-identidad-fija` resuelve una identidad declarada, y se habilita SOLO con APP_ENTORNO=local.
AUTH_PROVIDER=dev-identidad-fija   # dev-identidad-fija | supabase | cognito | identity-platform | gotrue

# Identidad con la que corre el CLI del Módulo 1 en desarrollo. Es el `user_id` que alimenta
# `set_config('app.user_id', ...)`, y tiene que tener una membresía en el estudio para ver algo.
# Sin esto, toda consulta devuelve cero filas — a propósito (ADR-0001 §6).
DEV_USER_ID=

# --- Job runner (docs/devops/03-reglas-desarrollo-optimizado.md §5) -------
# Secreto que autentica el disparo de un job desde afuera (cron del SO, Cloud Scheduler,
# EventBridge, K8s CronJob). DISTINTO por entorno a propósito: un disparo de local no tiene que
# servir contra staging. Generá el tuyo: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=cambiar-por-uno-propio-de-esta-maquina

# ============================================================
# NUNCA VA EN ESTE ARCHIVO (ni con valor de ejemplo):
#   - la clave privada de un certificado del organismo recaudador
#   - credenciales fiscales de un cliente
#   - cualquier dato real de un cliente (CUIT, CBU, razón social)
# Ver ADR-0002. Los certificados van por almacén de secretos del proveedor o por archivo montado
# fuera del repo, y acá va SOLO el nombre de la variable que apunta a ellos.
# ============================================================

# --- Pepper de identificadores (ADR-0002 §E) -------------------------------
# Secreto de servidor con el que se hashean los CBU para BUSCARLOS sin guardarlos.
# Un sha256 pelado de un CBU se revierte con un diccionario: el espacio es enumerable
# (22 dígitos, con banco y verificador dentro). Mínimo 32 caracteres.
# En producción viene del almacén de secretos, NUNCA de un archivo en el repo.
# Rotarlo obliga a recalcular la columna cbu_hmac de todas las cuentas: es un dato
# derivado, no una credencial de acceso.
IDENTIFICADOR_PEPPER=pepper_de_desarrollo_no_usar_en_produccion_0001
