#!/bin/sh
#
# Pre-commit: barrido de fuga sobre el repo — condición de salida nº 4 del Módulo 1.
#
# Corre ANTES de que el valor entre al historial, que es el único momento en que sirve: por ADR-0002
# §E.4.8, lo que ya está commiteado se considera público para siempre y no hay rotación posible para un
# importe. CI también lo corre, pero CI avisa cuando el commit ya existe.
#
# En esta máquina `privado/` existe, así que el barrido corre en MODO ESTRICTO: cruza cada candidato
# contra el material real de los clientes. Ese es el control de verdad, y es el que solo puede correr acá.
#
# Instalación:  pnpm hooks:instalar
# Salteo puntual y consciente:  git commit --no-verify   (queda en tu criterio, no en el mío)

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node no está en el PATH; se saltea el barrido de fuga." >&2
  exit 0
fi

node tools/barrido-fuga.ts
