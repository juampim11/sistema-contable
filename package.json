{
  "name": "sistema-contable",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres minio minio-init",
    "db:down": "docker compose down",
    "db:up:piloto": "docker compose -f docker-compose.piloto.yml up -d",
    "db:down:piloto": "docker compose -f docker-compose.piloto.yml down",
    "db:migrate": "node packages/data/scripts/migrar.ts",
    "db:setup": "node packages/data/scripts/setup-roles.ts",
    "db:seed": "node packages/data/scripts/sembrar.ts",
    "respaldar:piloto": "node packages/data/scripts/respaldar-piloto.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verificar": "pnpm typecheck && pnpm barrido && pnpm fixtures:verificar && pnpm test",
    "barrido": "node tools/barrido-fuga.ts",
    "barrido:aceptar": "node tools/barrido-fuga.ts --aceptar",
    "motor:version": "node packages/contabilidad/scripts/version-del-motor.ts",
    "motor:version:aceptar": "node packages/contabilidad/scripts/version-del-motor.ts --aceptar",
    "hooks:instalar": "git config core.hooksPath .githooks",
    "fixtures:generar": "node tools/generar-fixtures.ts",
    "fixtures:verificar": "node tools/verificar-fixtures.ts",
    "probar": "node packages/ingesta/scripts/probar-adaptador.ts",
    "ingesta": "node apps/cli/src/ingestar.ts",
    "completar-lote": "node apps/cli/src/completar-lote.ts",
    "alta:cuenta": "node apps/cli/src/alta-cuenta.ts",
    "alta:cliente": "node apps/cli/src/alta-cliente.ts",
    "exportar:excel": "node apps/cli/src/exportar-excel.ts",
    "salida:listar": "node packages/ingesta/scripts/listar-salida.ts",
    "recapturar:conceptos": "node apps/cli/src/recapturar-conceptos.ts",
    "backfill:contraparte": "node apps/cli/src/backfill-contraparte.ts",
    "backfill:documento-ingerido": "node apps/cli/src/backfill-documento-ingerido.ts",
    "alta:socio": "node apps/cli/src/alta-socio.ts",
    "alta:socio:placeholder-demo": "node apps/cli/src/alta-socio-placeholder-demo.ts",
    "resolver:contrapartida": "node apps/cli/src/resolver-contrapartida.ts",
    "reconocer:lote": "node apps/cli/src/reconocer-lote.ts",
    "calibrar:lexico": "node apps/cli/src/calibrar-lexico-metadatos.ts",
    "listar:conceptobanco": "node apps/cli/src/listar-conceptobanco-sin-reconocer.ts",
    "medir:identidad": "node apps/cli/src/medir-identidad-resuelta.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@sistema-contable/ingesta": "workspace:*",
    "@sistema-contable/shared": "workspace:*",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  }
}
